[
  {
    "name": "MSSQL 열거",
    "when": {"ports": [1433]},
    "suggest": [
      "netexec mssql {t}",
      "netexec mssql {t} -u {user} -p {pass} --local-auth",
      "impacket-mssqlclient {user}:{pass}@{t} -windows-auth"
    ],
    "note": "자격증명 확보 시 xp_cmdshell/링크드서버 점검. -u/-p 는 수동.",
    "tags": ["mssql", "db"],
    "phase": "enum"
  },
  {
    "name": "MySQL 열거",
    "when": {"ports": [3306], "services": ["mysql"]},
    "suggest": [
      "nmap -p3306 --script mysql-info,mysql-empty-password,mysql-users {t}",
      "mysql -h {t} -u root --password=''"
    ],
    "note": "빈/약한 root 암호, 파일읽기(secure_file_priv) 점검.",
    "tags": ["mysql", "db"],
    "phase": "enum"
  },
  {
    "name": "PostgreSQL 열거",
    "when": {"ports": [5432]},
    "suggest": [
      "netexec postgres {t}",
      "psql -h {t} -U postgres"
    ],
    "note": "COPY ... PROGRAM 으로 RCE 가능(버전 의존). -U 기본 postgres.",
    "tags": ["postgres", "db"],
    "phase": "enum"
  },
  {
    "name": "Redis 열거",
    "when": {"ports": [6379], "services": ["redis"]},
    "suggest": [
      "redis-cli -h {t} info",
      "redis-cli -h {t} --scan"
    ],
    "note": "인증 없으면 config set 으로 웹셸/SSH키 쓰기 시도(쓰기경로 확인 필요).",
    "tags": ["redis", "db"],
    "phase": "enum"
  },
  {
    "name": "SNMP 열거",
    "when": {"ports": [161]},
    "suggest": [
      "snmpwalk -v2c -c public {t}",
      "onesixtyone -c /usr/share/seclists/Discovery/SNMP/snmp.txt {t}",
      "snmpbulkwalk -v2c -c public {t} 1.3.6.1.2.1.25.4.2.1.2"
    ],
    "note": "community string 'public' 흔함. 프로세스/사용자/소프트웨어 누출.",
    "tags": ["snmp"],
    "phase": "enum"
  },
  {
    "name": "NFS 공유 열거",
    "when": {"ports": [2049]},
    "suggest": [
      "showmount -e {t}",
      "mkdir -p /mnt/nfs && mount -t nfs {t}:/ /mnt/nfs -o nolock"
    ],
    "note": "no_root_squash 면 SUID 바이너리 심어 privesc. 마운트는 로컬 권한 필요.",
    "tags": ["nfs"],
    "phase": "enum"
  },
  {
    "name": "RPC/rpcbind 열거",
    "when": {"ports": [111]},
    "suggest": [
      "rpcinfo -p {t}",
      "rpcclient -U \"\" -N {t} -c 'enumdomusers;querydominfo'"
    ],
    "note": "널 세션으로 사용자/도메인 정보 누출 가능.",
    "tags": ["rpc", "smb"],
    "phase": "enum"
  },
  {
    "name": "DNS 영역전송",
    "when": {"ports": [53], "services": ["domain"]},
    "suggest": [
      "dig axfr @{t}",
      "dnsenum --dnsserver {t} {domain}"
    ],
    "note": "AXFR 허용 시 내부 호스트명 대량 누출. {domain} 필요.",
    "tags": ["dns"],
    "phase": "enum"
  },
  {
    "name": "SMTP 사용자 열거",
    "when": {"ports": [25], "services": ["smtp"]},
    "suggest": [
      "nmap -p25 --script smtp-commands,smtp-enum-users {t}",
      "smtp-user-enum -M VRFY -U /usr/share/seclists/Usernames/Names/names.txt -t {t}"
    ],
    "note": "VRFY/EXPN/RCPT 로 유효 계정 확인.",
    "tags": ["smtp"],
    "phase": "enum"
  },
  {
    "name": "RDP 점검",
    "when": {"ports": [3389]},
    "suggest": [
      "netexec rdp {t}",
      "netexec rdp {t} -u {user} -p {pass}"
    ],
    "note": "NLA 여부/자격증명 유효성 확인. 확보 시 xfreerdp 접속.",
    "tags": ["rdp"],
    "phase": "enum"
  }
]
