[
  {
    "name": "웹 디렉토리 퍼징(ffuf/feroxbuster)",
    "when": {"ports": [80, 443, 8080, 8000, 8443], "services": ["http"]},
    "suggest": [
      "ffuf -u http://{t}/FUZZ -w /usr/share/seclists/Discovery/Web-Content/raft-medium-directories.txt -mc 200,204,301,302,307,401,403",
      "feroxbuster -u http://{t} -w /usr/share/seclists/Discovery/Web-Content/raft-medium-directories.txt"
    ],
    "note": "재귀 탐색. 403 도 우회 여지 있어 기록.",
    "tags": ["web", "fuzz"],
    "phase": "enum"
  },
  {
    "name": "웹 확장자/파일 퍼징",
    "when": {"ports": [80, 443, 8080], "services": ["http"]},
    "suggest": [
      "ffuf -u http://{t}/FUZZ -w /usr/share/seclists/Discovery/Web-Content/raft-medium-files.txt -e .php,.txt,.bak,.zip,.old -mc 200,301,302"
    ],
    "note": "백업/소스(.bak,.old,.zip)와 설정파일 노출 점검.",
    "tags": ["web", "fuzz"],
    "phase": "enum"
  },
  {
    "name": "웹 취약점 스캔(nikto)",
    "when": {"ports": [80, 443, 8080], "services": ["http"]},
    "suggest": ["nikto -h http://{t}"],
    "note": "오래된 컴포넌트/위험 파일 1차 스캔. 소음 큼.",
    "tags": ["web"],
    "phase": "enum"
  },
  {
    "name": "WordPress 점검",
    "when": {"ports": [80, 443, 8080], "services": ["http"]},
    "suggest": [
      "wpscan --url http://{t} --enumerate p,t,u --no-banner",
      "wpscan --url http://{t} --enumerate u"
    ],
    "note": "플러그인/테마/사용자 열거. /wp-login.php,/wp-content 보이면 적용.",
    "tags": ["web", "wordpress"],
    "phase": "enum"
  },
  {
    "name": "vhost/서브도메인 퍼징",
    "when": {"ports": [80, 443], "services": ["http"]},
    "suggest": [
      "ffuf -u http://{t}/ -H 'Host: FUZZ.{domain}' -w /usr/share/seclists/Discovery/DNS/subdomains-top1million-5000.txt -fs 0"
    ],
    "note": "응답 크기(-fs)로 거짓양성 제거. 발견 vhost 는 /etc/hosts 추가 후 재탐색. {domain} 필요.",
    "tags": ["web", "vhost"],
    "phase": "enum"
  },
  {
    "name": "SQL 인젝션 탐지(sqlmap)",
    "when": {"ports": [80, 443, 8080], "services": ["http"]},
    "suggest": [
      "sqlmap -u 'http://{t}/PATH?id=1' --batch --level 2 --risk 2",
      "sqlmap -r request.txt --batch --dbs"
    ],
    "note": "파라미터/폼 식별 후 적용. request.txt 는 Burp 저장본(수동).",
    "tags": ["web", "sqli", "access"],
    "phase": "access"
  },
  {
    "name": "LFI/경로우회 프로브",
    "when": {"ports": [80, 443, 8080], "services": ["http"]},
    "suggest": [
      "ffuf -u 'http://{t}/PATH?file=FUZZ' -w /usr/share/seclists/Fuzzing/LFI/LFI-Jhaddix.txt -mr 'root:.*:0:0'"
    ],
    "note": "file/page/include 류 파라미터 대상. LFI→로그포이즈닝/PHP wrapper 로 RCE 연계.",
    "tags": ["web", "lfi", "access"],
    "phase": "access"
  }
]
